#!/usr/bin/env node
const { execFileSync, execSync } = require("node:child_process");
const fs = require("node:fs");
const path = require("node:path");

const isWin = process.platform === "win32";
const isLinux = process.platform === "linux";

const nativeBinaryName = isWin ? "commitlg-cli-win-x64.exe" : "commitlg-cli-linux-x64";
const realScriptPath = fs.realpathSync(__filename);
const realDir = path.dirname(realScriptPath);
const srcNativeBinary = path.join(realDir, nativeBinaryName);

if (!fs.existsSync(srcNativeBinary)) {
  console.error(`clg: Biner native ${nativeBinaryName} tidak ditemukan di paket.`);
  process.exit(1);
}

// --- KHUSUS WINDOWS: Tambahkan PATH & Hapus Shim npm (.cmd / .ps1) ---
if (isWin) {
  try {
    // 1. Tambah PATH via PowerShell
    const getPathCmd = `powershell -NoProfile -Command "[Environment]::GetEnvironmentVariable('Path', 'User')"`;
    const currentUserPath = execSync(getPathCmd, { encoding: "utf8" }).trim();
    const pathEntries = currentUserPath.split(";").map((p) => p.trim().toLowerCase());

    if (!pathEntries.includes(realDir.trim().toLowerCase())) {
      const newPath = currentUserPath ? `${currentUserPath};${realDir}` : realDir;
      const setPathCmd = `powershell -NoProfile -Command "[Environment]::SetEnvironmentVariable('Path', '${newPath.replace(/'/g, "''")}', 'User')"`;
      execSync(setPathCmd);
    }

    // 2. Hapus shim npm (.cmd / .ps1) yang memaksa panggilan via 'node'
    const globalNpmBinDir = path.dirname(realDir); // Folder bin global npm
    const cmdShim = path.join(globalNpmBinDir, "clg.cmd");
    const ps1Shim = path.join(globalNpmBinDir, "clg.ps1");

    if (fs.existsSync(cmdShim)) fs.unlinkSync(cmdShim);
    if (fs.existsSync(ps1Shim)) fs.unlinkSync(ps1Shim);
  } catch (_) {}
}

try {
  const backupPath = realScriptPath + ".bak";

  // Swap/Move
  fs.renameSync(realScriptPath, backupPath);
  fs.renameSync(srcNativeBinary, realScriptPath);

  if (isLinux) {
    try {
      fs.chmodSync(realScriptPath, 0o755);
    } catch (_) {
      execFileSync("chmod", ["+x", realScriptPath]);
    }
  }

  // Eksekusi biner Rust murni
  execFileSync(realScriptPath, process.argv.slice(2), { stdio: "inherit" });
} catch (e) {
  console.error(`clg swap error: ${e.message}`);
  process.exit(e.status ?? 1);
}
