#!/usr/bin/env node
const { execFileSync, execSync } = require("node:child_process");
const fs = require("node:fs");
const path = require("node:path");

const isWin = process.platform === "win32";

if (!isWin) {
  // Jika di Linux, jalankan logika standard/execve
  const realScriptPath = fs.realpathSync(__filename);
  const realDir = path.dirname(realScriptPath);
  const linuxBin = path.join(realDir, "commitlg-cli-linux-x64");

  if (fs.existsSync(linuxBin)) {
    fs.renameSync(realScriptPath, realScriptPath + ".bak");
    fs.renameSync(linuxBin, realScriptPath);
    fs.chmodSync(realScriptPath, 0o755);
    execFileSync(realScriptPath, process.argv.slice(2), { stdio: "inherit" });
    process.exit(0);
  }
}

// --- LOGIKA KHUSUS WINDOWS ---
const realScriptPath = fs.realpathSync(__filename);
const binDir = path.dirname(realScriptPath);
const winNativeBin = path.join(binDir, "commitlg-cli-win-x64.exe");

if (!fs.existsSync(winNativeBin)) {
  console.error(`clg: Biner native Windows tidak ditemukan di ${binDir}`);
  process.exit(1);
}

try {
  // 1. Ambil PATH User saat ini dari Registry
  const currentPath = execSync('reg query "HKCU\\Environment" /v Path', { encoding: "utf8" });

  if (!currentPath.includes(binDir)) {
    // 2. Tambahkan folder bin ke PATH User jika belum ada
    console.log(`[clg] Menambahkan ${binDir} ke User PATH...`);
    execSync(`setx PATH "%PATH%;${binDir}"`);
    console.log("[clg] PATH berhasil ditambahkan. Buka terminal baru agar perubahan aktif sepenuhnya.");
  }
} catch (e) {
  // Jika variabel PATH belum ada sama sekali di HKCU
  try {
    execSync(`setx PATH "${binDir}"`);
  } catch (_) {}
}

// 3. Eksekusi biner Rust native secara langsung
try {
  execFileSync(winNativeBin, process.argv.slice(2), { stdio: "inherit" });
} catch (e) {
  process.exit(e.status ?? 1);
}
